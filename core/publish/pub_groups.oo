// # Hub Package Group Parser & @group Transitive Expander
//
// Logline: Parses catalog/groups.oot and expands @group selections into deduplicated package names.
// Setup: Explicit FsReadCap for reading groups.oot; ASCII byte checks prevent traversal operands.
// Beats:
//   1. Trim comments and whitespace from @group definitions in catalog/groups.oot.
//   2. Expand transitive @group references in FIFO queue order without cycles.
//   3. Deduplicate package selections while preserving first-seen canonical order.

pub fn pub_trim(s: String) -> String {
    let n: Int = bytes_len(s);
    let mut lo: Int = 0;
    while lo < n {
        let b: Int = byte_at(s, lo);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            lo = lo + 1;
        } else {
            break;
        }
    }
    let mut hi: Int = n;
    while hi > lo {
        let b: Int = byte_at(s, hi - 1);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            hi = hi - 1;
        } else {
            break;
        }
    }
    return byte_slice(s, lo, hi);
}

pub fn pub_split_ws(s: String) -> List[String] {
    let mut out: List[String] = list_new();
    let n: Int = bytes_len(s);
    let mut i: Int = 0;
    while i < n {
        while i < n && (byte_at(s, i) == 32 || byte_at(s, i) == 9 ||
            byte_at(s, i) == 10 || byte_at(s, i) == 13) { i = i + 1; }
        let st: Int = i;
        while i < n && byte_at(s, i) != 32 && byte_at(s, i) != 9 &&
            byte_at(s, i) != 10 && byte_at(s, i) != 13 { i = i + 1; }
        if i > st { out = list_push(out, byte_slice(s, st, i)); }
    }
    return out;
}

pub fn pub_clean_path(p: String) -> Bool {
    if p == "" { return false; }
    let mut k: Int = 0;
    while k + 1 < bytes_len(p) {
        if byte_at(p, k) == 46 && byte_at(p, k + 1) == 46 { return false; }
        k = k + 1;
    }
    return true;
}

pub fn pub_groups_load(fs_r: &FsReadCap, gfile: String) -> Result[List[String], String] {
    if !pub_clean_path(gfile) { return Err("refused traversal path in groups"); }
    let rd: Result[String, String] = read_file(fs_r, gfile);
    if rd.is_err() { return Err("groups file missing: " + gfile); }
    let mut defs: List[String] = list_new();
    let lines: List[String] = str_split(rd.val, "\n");
    let mut i: Int = 0;
    while i < list_len(lines) {
        let raw: String = list_get(lines, i);
        let h: Int = str_index_of(raw, "#");
        let no_c: String = if h >= 0 { str_slice(raw, 0, h) } else { raw };
        let ln: String = pub_trim(no_c);
        if str_starts_with(ln, "@") && str_contains(ln, "=") {
            let eq: Int = str_index_of(ln, "=");
            let nm: String = pub_trim(str_slice(ln, 1, eq));
            let val: String = pub_trim(str_slice(ln, eq + 1, chars_len(ln)));
            if nm != "" { defs = list_push(defs, nm + "\t" + val); }
        }
        i = i + 1;
    }
    if list_len(defs) == 0 { return Err("no @group definitions parsed from " + gfile); }
    return Ok(defs);
}

fn pg_lookup(defs: List[String], nm: String) -> String {
    let pre: String = nm + "\t";
    let mut i: Int = 0;
    while i < list_len(defs) {
        let ent: String = list_get(defs, i);
        if str_starts_with(ent, pre) { return str_slice(ent, chars_len(pre), chars_len(ent)); }
        i = i + 1;
    }
    return "";
}

pub fn pub_groups_expand(defs: List[String], want: String) -> Result[List[String], String] {
    let mut out: List[String] = list_new();
    let mut out_set: String = "\t";
    let mut g_seen: String = "\t";
    let mut q: List[String] = list_push(list_new(), want);
    let mut qi: Int = 0;
    while qi < list_len(q) {
        let g: String = list_get(q, qi);
        qi = qi + 1;
        if str_contains(g_seen, "\t" + g + "\t") { continue; }
        g_seen = g_seen + g + "\t";
        let body: String = pg_lookup(defs, g);
        if body == "" { return Err("unknown group @" + g); }
        let toks: List[String] = pub_split_ws(body);
        let mut ti: Int = 0;
        while ti < list_len(toks) {
            let tok: String = list_get(toks, ti);
            ti = ti + 1;
            if str_starts_with(tok, "@") { q = list_push(q, str_slice(tok, 1, chars_len(tok))); }
            else if !str_contains(out_set, "\t" + tok + "\t") {
                out_set = out_set + tok + "\t";
                out = list_push(out, tok);
            }
        }
    }
    return Ok(out);
}

pub fn pub_select_pkgs(fs_r: &FsReadCap, gfile: String, argv: List[String]) -> Result[List[String], String] {
    if list_len(argv) == 0 {
        let dr: Result[List[String], String] = pub_groups_load(fs_r, gfile);
        if dr.is_err() { return Err(match dr { Ok(_) => "", Err(e) => e }); }
        return pub_groups_expand(dr.val, "all");
    }
    let mut need_grp: Bool = false;
    let mut i: Int = 0;
    while i < list_len(argv) {
        if str_starts_with(list_get(argv, i), "@") { need_grp = true; }
        i = i + 1;
    }
    let mut defs: List[String] = list_new();
    if need_grp {
        let dr2: Result[List[String], String] = pub_groups_load(fs_r, gfile);
        if dr2.is_err() { return Err(match dr2 { Ok(_) => "", Err(e) => e }); }
        defs = dr2.val;
    }
    let mut out: List[String] = list_new();
    let mut seen: String = "\t";
    i = 0;
    while i < list_len(argv) {
        let a: String = list_get(argv, i);
        i = i + 1;
        if str_starts_with(a, "@") {
            let er: Result[List[String], String] = pub_groups_expand(defs, str_slice(a, 1, chars_len(a)));
            if er.is_err() { return Err(match er { Ok(_) => "", Err(e) => e }); }
            let mut k: Int = 0;
            while k < list_len(er.val) {
                let p: String = list_get(er.val, k);
                if !str_contains(seen, "\t" + p + "\t") {
                    seen = seen + p + "\t";
                    out = list_push(out, p);
                }
                k = k + 1;
            }
        } else if a != "" && !str_contains(seen, "\t" + a + "\t") {
            seen = seen + a + "\t";
            out = list_push(out, a);
        }
    }
    return Ok(out);
}
