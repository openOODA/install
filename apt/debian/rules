#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	dh_auto_install
	install -d debian/openooda/usr/bin
	install -d debian/openooda/usr/lib/openooda
	# Stage binaries from ../dist/*-linux-* (built upstream by the release pipeline).
	if ls ../dist/*-linux-* >/dev/null 2>&1; then \
		install -m 0755 ../dist/*-linux-* debian/openooda/usr/bin/ ; \
	fi
	if ls ../dist/*-linux-*.a >/dev/null 2>&1; then \
		install -m 0644 ../dist/*-linux-*.a debian/openooda/usr/lib/openooda/ ; \
	fi
