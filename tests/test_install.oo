// # install Verification Suite
//
// Logline: Positive and negative-trust assertions over the QA seal and the repo's canonical invariants.
//
// Setup: Pure functions over integers. No IO beyond the read capability.
//
// Beats:
//   1. Assert the seal round is deterministic and positive.
//   2. Assert a tampered nonce changes the seal.
//   3. Assert a forged digest fails closed.
//   4. Assert the nonce sweep stays distinct, positive, and reproducible.

import "std/sec/pqc.oo";

fn expect(cond: Bool, label: String) -> Bool {
    if cond {
        println("ok " + label);
        return true;
    }
    println("FAIL " + label);
    return false;
}

pub fn main(
    fs_r: &FsReadCap,
    args: List[String]
) -> Result[Int, String] {
    let mut p: Int = 0;
    if expect(oo_pqc_sha3_round(41, 7) == oo_pqc_sha3_round(41, 7), "01 seal round is deterministic") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) > 0, "02 seal stays in the positive field") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(41, 8), "03 tampered nonce yields a different seal") { p = p + 1; }
    if expect(oo_pqc_sha3_round(0, 7) != oo_pqc_sha3_round(41, 7), "04 forged digest yields a different seal") { p = p + 1; }
    let s1: Int = oo_pqc_sha3_round(41, 101);
    let s2: Int = oo_pqc_sha3_round(41, 202);
    let s3: Int = oo_pqc_sha3_round(41, 303);
    let distinct: Bool = s1 != s2 && s1 != s3 && s2 != s3;
    if expect(distinct, "05 nonce sweep yields distinct seals") { p = p + 1; }
    if expect(s1 > 0 && s2 > 0 && s3 > 0, "06 nonce sweep seals stay positive") { p = p + 1; }
    let repro: Bool = oo_pqc_sha3_round(41, 101) == s1 &&
        oo_pqc_sha3_round(41, 202) == s2 && oo_pqc_sha3_round(41, 303) == s3;
    if expect(repro, "07 sweep seals reproduce bit-for-bit") { p = p + 1; }
    if expect(oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(7, 41), "08 digest/nonce order binds the seal") { p = p + 1; }
    let ds: Bool = oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(42, 7) &&
        oo_pqc_sha3_round(41, 7) != oo_pqc_sha3_round(43, 7) &&
        oo_pqc_sha3_round(42, 7) != oo_pqc_sha3_round(43, 7);
    if expect(ds, "09 digest sweep yields distinct seals") { p = p + 1; }
    if expect(oo_pqc_sha3_round(0, 0) != oo_pqc_sha3_round(41, 7), "10 zero-zero boundary differs from honest") { p = p + 1; }
    let neg: Bool = oo_pqc_sha3_round(0 - 1, 7) != oo_pqc_sha3_round(41, 7) &&
        oo_pqc_sha3_round(41, 0 - 1) != oo_pqc_sha3_round(41, 7) &&
        oo_pqc_sha3_round(0 - 1, 0 - 1) == oo_pqc_sha3_round(0 - 1, 0 - 1);
    if expect(neg, "11 negative inputs stay deterministic and distinct") { p = p + 1; }
    let ext: Bool = oo_pqc_sha3_round(2147483647, 0) != oo_pqc_sha3_round(0, 2147483647) &&
        oo_pqc_sha3_round(2147483647, 0) != oo_pqc_sha3_round(41, 7) &&
        oo_pqc_sha3_round(0, 2147483647) != oo_pqc_sha3_round(41, 7);
    if expect(ext, "12 extreme limb asymmetry binds the seal") { p = p + 1; }
    let inband: Bool = oo_pqc_sha3_round(41, 7) >= 1 &&
        oo_pqc_sha3_round(41, 7) <= 4611686018427387903 &&
        oo_pqc_sha3_round(0 - 1, 0 - 1) >= 1 &&
        oo_pqc_sha3_round(0 - 1, 0 - 1) <= 4611686018427387903 &&
        oo_pqc_sha3_round(2147483647, 0) <= 4611686018427387903;
    if expect(inband, "13 seals stay inside the positive 62-bit field") { p = p + 1; }
    let floor: Bool = oo_pqc_sha3_round(0, 0) >= 1 && oo_pqc_sha3_round(0 - 1, 7) >= 1 &&
        oo_pqc_sha3_round(41, 7) >= 1;
    if expect(floor, "14 degenerate inputs floor at 1, never zero") { p = p + 1; }
    if p == 14 {
        println("install tests: 14/14 passed");
        return Ok(0);
    }
    println("install tests: FAILED (" + to_string(p) + "/14)");
    return Ok(1);
}
