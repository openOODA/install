// # install Update Surface Verification — Pin Grammar, Channel Binding, Transaction Guards
//
// Logline: Assert the update/pin trust surface in install.sh stays fail-closed: strict version grammar, charset-bound release refs, atomic state commit, and partial-install refusal.
//
// Setup: Read-only FsReadCap over install.sh and versions.toml. Pure string assertions; no subprocess, no network.
//
// Beats:
//   1. Assert the pin grammar admits only quoted vX.Y.Z values.
//   2. Assert release and git channels bind --tag/--branch to PINS lookups only.
//   3. Assert the install-state transaction commits atomically behind fail-closed guards.
//   4. Assert the shipped versions.toml carries no dead channel directives.

import "oostd/core/primitives/str.oo";
import "oostd/fs/os/fs.oo";

fn expect(cond: Bool, label: String) -> Bool {
    if cond {
        println("ok " + label);
        return true;
    }
    println("FAIL " + label);
    return false;
}

// Count live versions.toml directives that are not pin-shaped. A line
// load_pins would silently skip is dead config and a potential
// channel/branch mismatch smuggled past the grammar.
fn dead_directives(toml: String) -> Int {
    let mut rest: String = toml;
    let mut bad: Int = 0;
    while bytes_len(rest) > 0 {
        let nl: Int = str_index_of(rest, "\n");
        let ln: String = if nl < 0 { rest } else { byte_slice(rest, 0, nl) };
        rest = if nl < 0 { "" } else { byte_slice(rest, nl + 1, bytes_len(rest)) };
        let n: Int = bytes_len(ln);
        let mut i: Int = 0;
        while i < n {
            let c: Int = byte_at(ln, i);
            if c != 32 && c != 9 { break; }
            i = i + 1;
        }
        if i < n && byte_at(ln, i) != 35 && str_index_of(ln, "=\"v") < 0 {
            bad = bad + 1;
        }
    }
    return bad;
}

// Count live versions.toml lines: non-empty and not comment-led.
// Zero means the shipped file is comment-only, so the pin table
// starts empty and every consumer must ride its :- default.
fn live_lines(toml: String) -> Int {
    let mut rest: String = toml;
    let mut n: Int = 0;
    while bytes_len(rest) > 0 {
        let nl: Int = str_index_of(rest, "\n");
        let ln: String = if nl < 0 { rest } else { byte_slice(rest, 0, nl) };
        rest = if nl < 0 { "" } else { byte_slice(rest, nl + 1, bytes_len(rest)) };
        let m: Int = bytes_len(ln);
        let mut i: Int = 0;
        while i < m {
            let c: Int = byte_at(ln, i);
            if c != 32 && c != 9 { break; }
            i = i + 1;
        }
        if i < m && byte_at(ln, i) != 35 { n = n + 1; }
    }
    return n;
}

pub fn main(
    fs_r: &FsReadCap,
    _args: List[String]
) -> Result[Int, String] {
    let mut p: Int = 0;
    let sh: Result[String, String] = fs_read_file(fs_r, "install.sh");
    let src: String = if sh.is_ok() { sh.val } else { "" };
    let vt: Result[String, String] = fs_read_file(fs_r, "versions.toml");
    let toml: String = if vt.is_ok() { vt.val } else { "" };
    let g1: Bool = str_contains(src, "v[0-9]+\\.[0-9]+\\.[0-9]+") &&
        str_contains(src, "PINS[\"${BASH_REMATCH[1]}\"]=\"${BASH_REMATCH[2]}\"");
    if expect(g1, "01 pin grammar admits only quoted vX.Y.Z releases") { p = p + 1; }
    let g2: Bool = str_contains(src, "tagargs=(--tag \"$tag\")") &&
        str_contains(src, "${PINS[$key]:-latest}") &&
        str_contains(src, "tag=\"${PINS[$key]:-}\"");
    if expect(g2, "02 release channel binds --tag to PINS lookups only") { p = p + 1; }
    let g3: Bool = str_contains(src, "args+=(--branch \"$branch\")") &&
        str_contains(src, "fetch_repo \"https://github.com/openOODA-core/std\" \"$STD_DIR\" \"anchor.oo\" \"${PINS[std]:-}\"");
    if expect(g3, "03 git channel binds --branch to the std pin only") { p = p + 1; }
    let g4: Bool = str_contains(src, "mv -f \"$tmp\" \"$RESULTS_FILE\"") &&
        str_contains(src, "install state was lost") &&
        str_contains(src, "install state file is missing or unreadable") &&
        str_contains(src, "install state file has bad syntax");
    if expect(g4, "04 install state commits atomically behind fail-closed guards") { p = p + 1; }
    let g5: Bool = str_contains(src, "refusing partial install") &&
        str_contains(src, "\"$key\" == \"ooda\" || \"$key\" == \"oodac\"");
    if expect(g5, "05 partial install refuses fail-closed for core tools") { p = p + 1; }
    let g6: Bool = vt.is_ok() && dead_directives(toml) == 0;
    if expect(g6, "06 shipped versions.toml carries no dead channel directives") { p = p + 1; }
    let g7: Bool = str_contains(src, "declare -A PINS=()") &&
        str_contains(src, "while IFS= read -r line") &&
        str_contains(src, "PINS[\"${BASH_REMATCH[1]}\"]=\"${BASH_REMATCH[2]}\"");
    if expect(g7, "07 pins resolve per-component through one associative table") { p = p + 1; }
    let g8: Bool = vt.is_ok() && live_lines(toml) == 0 &&
        str_contains(src, "set -euo pipefail") &&
        str_contains(src, "${PINS[$key]:-latest}") &&
        str_contains(src, "${PINS[$key]:-}") &&
        str_contains(src, "${PINS[std]:-}");
    if expect(g8, "08 empty pin table stays safe under set -u via defaulted lookups") { p = p + 1; }
    let g9: Bool = str_contains(src, "v[0-9]+\\.[0-9]+\\.[0-9]+") &&
        str_contains(src, "|| continue") &&
        str_contains(src, "declare -A PINS=()");
    if expect(g9, "09 pin grammar refuses unquoted or non-semver values before fetch refs") { p = p + 1; }
    let g10: Bool = str_contains(src, "! -f \"$rc.bak.openooda\"") &&
        str_contains(src, "cp -p \"$rc\" \"$rc.bak.openooda\"") &&
        str_contains(src, ".bak.openooda backup");
    if expect(g10, "10 rc edits are preceded by a single-shot backup for rollback") { p = p + 1; }
    if p == 10 {
        println("install update tests: 10/10 passed");
        return Ok(0);
    }
    println("install update tests: FAILED (" + to_string(p) + "/10)");
    return Ok(1);
}
