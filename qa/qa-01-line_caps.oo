// # qa-01-line_caps.oo — 256-line cap & lowercase canonical probe
//
// Logline: Fail closed if any .oo/.oot file in install/ exceeds 256 lines or violates lowercase canonical naming.
//          Re-verifies the RULES §1.8 and §1.19 invariants for this repo.
//
// Setup: Uses ProcessCap to shell out to find + wc.
//        INSTALL_ROOT env var must point at the install/ tree.
//        Read-only; no network, no writes.
//
// Beats:
//   1. Discover .oo/.oot files under install/ (excluding .git/).
//   2. Count lines per file with wc -l; fail on any line count > 256.
//   3. Assert canonical files are lowercase; fail on deprecated uppercase boards.

fn install_root(env: &EnvCap) -> String {
  let r: Result[String, String] = env_get(env, "INSTALL_ROOT");
  return match r { Ok(s) => s, Err(_) => "/home/jeryd/Projects/openOODA/install" };
}

pub fn main(p: &ProcessCap, fs_r: &FsReadCap, sys: &SysCap, env: &EnvCap, time: &TimeCap, fs_w: &FsWriteCap, alloc: &AllocCap, args: List[String]) -> Result[Int, String] {
  let root: String = install_root(env);
  // One shell pipeline: find .oo/.oot files, count lines, fail on > 256.
  let cmd: String = "find " + root + " -type f \\( -name '*.oo' -o -name '*.oot' \\) -not -path '*/.git/*' -not -path '*/audit/*' | while read f; do n=$(wc -l < \"$f\"); if [ \"$n\" -gt 256 ]; then echo \"$n $f\"; fi; done | head -1";
  let cr: Result[String, String] = sys_exec(p, "bash", "-c", cmd);
  if cr.is_err() {
    let err_msg: String = match cr { Ok(_) => "", Err(e) => e };
    return Err("qa-01: shell pipeline failed: " + err_msg);
  }
  let bad: String = match cr { Ok(s) => s, Err(_) => "" };
  if bad != "" {
    return Err("qa-01: line-cap violation: " + bad);
  }

  // Reject deprecated uppercase canonical boards
  let upper_cmd: String = "find " + root + " -type f \\( -name 'ANCHOR.oo' -o -name 'INSTALL.md' -o -name 'SURFACE.oot' \\) -not -path '*/.git/*' | head -1";
  let ur: Result[String, String] = sys_exec(p, "bash", "-c", upper_cmd);
  if ur.is_err() {
    let u_err: String = match ur { Ok(_) => "", Err(e) => e };
    return Err("qa-01: canonical check failed: " + u_err);
  }
  let upper_found: String = match ur { Ok(s) => s, Err(_) => "" };
  if upper_found != "" {
    return Err("qa-01: uppercase canonical violation: " + upper_found);
  }

  println("qa-01: all .oo/.oot files <= 256 lines and canonical files lowercase");
  return Ok(0);
}
