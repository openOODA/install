pkgname=openooda
pkgver=0.1.0
pkgrel=1
pkgdesc="openOODA — Sovereign Systems Language for the AI Era"
arch=('x86_64' 'aarch64')
url="https://openooda.org"
license=('MIT')
depends=('glibc')
source=("https://github.com/openOODA/packaging/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    mkdir -p "${pkgdir}/usr/bin"
    mkdir -p "${pkgdir}/usr/lib/openooda"
    if ls "${srcdir}/../dist/"*-linux-* >/dev/null 2>&1; then
        install -m 0755 "${srcdir}/../dist/"*-linux-* "${pkgdir}/usr/bin/"
    fi
    if ls "${srcdir}/../dist/"*-linux-*.a >/dev/null 2>&1; then
        install -m 0644 "${srcdir}/../dist/"*-linux-*.a "${pkgdir}/usr/lib/openooda/"
    fi
}
