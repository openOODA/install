pkgname=openooda
pkgver=0.1.30
pkgrel=1
pkgdesc="openOODA — Primary Systems Language for the AI Era (including blackbox)"
arch=('x86_64' 'aarch64')
url="https://openooda.org"
license=('MIT')
depends=('glibc')
makedepends=('git')
source=("https://github.com/openOODA/install/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    mkdir -p "${pkgdir}/usr/bin"
    mkdir -p "${pkgdir}/usr/lib/openooda"
    mkdir -p "${pkgdir}/etc/profile.d"
    for f in "${srcdir}/../dist/"*-linux-*; do
        [ -f "$f" ] || continue
        case "$f" in
            *.a|*liboodar.a*)
                install -m 0644 "$f" "${pkgdir}/usr/lib/openooda/liboodar.a" ;;
            *)
                b=$(basename "$f" | sed -E 's/-linux-(x86_64|arm64)$//')
                install -m 0755 "$f" "${pkgdir}/usr/bin/$b" ;;
        esac
    done
    git clone --depth 1 https://github.com/openOODA/std "${pkgdir}/usr/lib/openooda/std"
    rm -rf "${pkgdir}/usr/lib/openooda/std/.git"
    install -m 0644 "${srcdir}/profile.d.sh" "${pkgdir}/etc/profile.d/openooda.sh"
}
